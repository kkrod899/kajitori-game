{"schema_version":2,"part":"05_safety_emergency","rules":[{"rule_id":"safety.floor_small_object_hazard","maturity":"experiment_ready","description":"床の小物・誤飲物が観察された時だけ表示する","profile_all_tags":["has_child"],"profile_config_equals":{},"when":{"path":"household.safety.floor_hazard_present","op":"truthy"},"emit":[{"id":"SAFE-002","layer":"now","reason":"床または手の届く場所に小物・誤飲物がある"}]},{"rule_id":"safety.button_battery_or_magnet_storage_issue","maturity":"experiment_ready","description":"ボタン電池・磁石等の保管問題が観察された時だけ表示する","profile_all_tags":["has_child"],"profile_config_equals":{},"when":{"path":"household.safety.button_battery_or_magnet_storage_issue","op":"truthy"},"emit":[{"id":"SAFE-003","layer":"now","reason":"ボタン電池・磁石等の保管状態に問題がある"}]},{"rule_id":"safety.chemical_storage_issue","maturity":"experiment_ready","description":"薬・洗剤等の保管問題が観察された時だけ表示する","profile_all_tags":["has_child"],"profile_config_equals":{},"when":{"path":"household.safety.chemical_storage_issue","op":"truthy"},"emit":[{"id":"SAFE-004","layer":"now","reason":"薬・洗剤等が子どもの手の届く状態にある"}]},{"rule_id":"safety.fall_hazard_present","maturity":"experiment_ready","description":"家具・ベッド・ソファ周辺の転落要因が観察された時だけ表示する","profile_all_tags":["has_child"],"profile_config_equals":{},"when":{"path":"household.safety.fall_hazard_present","op":"truthy"},"emit":[{"id":"SAFE-005","layer":"now","reason":"家具・ベッド・ソファ周辺に転落要因がある"}]},{"rule_id":"safety.gate_or_barrier_issue","maturity":"experiment_ready","description":"ゲート・柵の設置または固定状態に問題がある時だけ表示する","profile_all_tags":["has_child"],"profile_config_equals":{},"when":{"path":"household.safety.gate_or_barrier_issue","op":"truthy"},"emit":[{"id":"SAFE-006","layer":"now","reason":"ベビーゲート・柵の設置状態に問題がある"}]},{"rule_id":"safety.cord_or_outlet_hazard","maturity":"experiment_ready","description":"コード・コンセント・ひも類の危険が観察された時だけ表示する","profile_all_tags":["has_child"],"profile_config_equals":{},"when":{"path":"household.safety.cord_or_outlet_hazard_present","op":"truthy"},"emit":[{"id":"SAFE-007","layer":"now","reason":"コード・コンセント・ひも類に危険がある"}]},{"rule_id":"safety.hot_food_or_cooking_context","maturity":"experiment_ready","description":"子どもの近くで熱い物や調理器具を扱う文脈だけで表示する","profile_all_tags":["has_child"],"profile_config_equals":{},"when":{"path":"context.hot_food_or_cooking_near_child","op":"truthy"},"emit":[{"id":"SAFE-008","layer":"now","reason":"子どもの近くで熱い飲食物・調理器具を扱う"}]},{"rule_id":"safety.water_activity_context","maturity":"experiment_ready","description":"浴槽・洗面等の水回り活動中だけ表示する","profile_all_tags":["has_child"],"profile_config_equals":{},"when":{"path":"context.water_activity_active","op":"truthy"},"emit":[{"id":"SAFE-009","layer":"now","reason":"子どもを伴う水回り活動の最中である"}]},{"rule_id":"safety.food_choking_context","maturity":"experiment_ready","description":"食事・食品準備の具体的文脈がある時だけ表示する","profile_all_tags":["has_child"],"profile_config_equals":{},"when":{"all":[{"path":"context.meal_or_food_preparation_active","op":"truthy"},{"path":"children.older.eating.food_context_available","op":"truthy"}]},"emit":[{"id":"SAFE-010","layer":"now","reason":"子どもの食事・食品準備の具体的文脈がある"}]},{"rule_id":"safety.childseat_check","maturity":"experiment_ready","description":"車利用時または点検条件がある時にチャイルドシートを確認する","profile_all_tags":["uses_car","has_child"],"profile_config_equals":{},"when":{"any":[{"all":[{"path":"context.outing.planned","op":"truthy"},{"path":"context.outing.car_used","op":"truthy"}]},{"path":"household.equipment.childseat_check_due","op":"truthy"},{"path":"household.equipment.childseat_issue","op":"truthy"}]},"emit":[{"id":"SAFE-011","layer":"now","reason":"車利用またはチャイルドシート確認条件がある"},{"id":"GROW-005","layer":"review","reason":"成長に対する使用条件の適合も確認する"}]},{"rule_id":"safety.stroller_check","maturity":"experiment_ready","description":"ベビーカー利用文脈と製品説明書参照がある時だけ表示する","profile_all_tags":["infant"],"profile_config_equals":{},"when":{"all":[{"path":"context.outing.stroller_used","op":"truthy"},{"path":"household.equipment.stroller_manual_available","op":"truthy"}]},"emit":[{"id":"SAFE-012","layer":"now","reason":"ベビーカー利用予定があり、製品固有の確認が可能"}]},{"rule_id":"safety.bicycle_childseat_check","maturity":"experiment_ready","description":"自転車幼児座席を実際に使う家庭・外出だけで表示する","profile_all_tags":["uses_bicycle_childseat","has_child"],"profile_config_equals":{"uses_bicycle_childseat":true},"when":{"all":[{"path":"context.outing.planned","op":"truthy"},{"path":"context.outing.bicycle_childseat_used","op":"truthy"}]},"emit":[{"id":"SAFE-013","layer":"now","reason":"自転車幼児座席を使う外出予定がある"}]},{"rule_id":"safety.outing_hazard_context","maturity":"experiment_ready","description":"道路・駐車場・階段等の具体的危険文脈がある外出だけで表示する","profile_all_tags":["has_child"],"profile_config_equals":{},"when":{"all":[{"path":"context.outing.planned","op":"truthy"},{"path":"context.outing.hazard_context_available","op":"truthy"}]},"emit":[{"id":"SAFE-014","layer":"now","reason":"外出先に道路・駐車場・階段等の危険文脈がある"}]},{"rule_id":"safety.mobility_or_reach_changed","maturity":"experiment_ready","description":"養育者が移動範囲・到達範囲の変化を記録した時だけ表示する","profile_all_tags":["infant"],"profile_config_equals":{},"when":{"all":[{"path":"children.infant.growth.mobility_or_reach_changed","op":"truthy"},{"path":"children.infant.growth.change_observed_at","op":"exists"}]},"emit":[{"id":"SAFE-017","layer":"now","reason":"移動・到達範囲の変化が観察された"},{"id":"GROW-012","layer":"review","reason":"新たに届く危険箇所を再点検する必要"}]},{"rule_id":"safety.heat_outing_context","maturity":"experiment_ready","description":"公式の暑熱情報と子どもを伴う外出が同時にある時だけ表示する","profile_all_tags":["has_child"],"profile_config_equals":{},"when":{"all":[{"path":"context.weather.official_heat_alert_or_high_wbgt","op":"truthy"},{"path":"context.outing.planned","op":"truthy"},{"path":"context.outing.with_child","op":"truthy"}]},"emit":[{"id":"SAFE-018","layer":"now","reason":"公式の暑熱情報があり、子どもを伴う外出予定がある"},{"id":"PLAN-008","layer":"today","reason":"暑熱情報を踏まえて外出準備または計画変更が必要"}]},{"rule_id":"safety.winter_weather_outing_context","maturity":"experiment_ready","description":"公式の大雪・暴風雪情報と外出・移動文脈がある時だけ表示する","profile_all_tags":["has_child"],"profile_config_equals":{},"when":{"all":[{"path":"context.weather.official_snow_or_blizzard_warning","op":"truthy"},{"path":"context.outing.planned","op":"truthy"},{"path":"context.outing.transport_context_available","op":"truthy"}]},"emit":[{"id":"SAFE-019","layer":"now","reason":"公式の大雪・暴風雪情報があり、子どもを伴う移動予定がある"},{"id":"PLAN-006","layer":"now","reason":"移動時間・交通手段・中止判断を再確認する必要"},{"id":"PLAN-008","layer":"today","reason":"防寒・雪対策または外出回避を具体化する必要"}]},{"rule_id":"emergency.core_review_due","maturity":"experiment_ready","description":"災害準備の定期レビューが到来した時だけまとめて表示する","profile_all_tags":["household"],"profile_config_equals":{},"when":{"path":"household.emergency.review_due","op":"truthy"},"emit":[{"id":"EMG-001","layer":"review","reason":"避難先・避難経路の確認時期"},{"id":"EMG-002","layer":"review","reason":"飲料水の備蓄量・期限の確認時期"},{"id":"EMG-003","layer":"review","reason":"非常食の備蓄量・期限の確認時期"},{"id":"EMG-004","layer":"review","reason":"乳児用品の災害備蓄確認時期"},{"id":"EMG-005","layer":"review","reason":"照明・モバイルバッテリー等の充電確認時期"},{"id":"EMG-006","layer":"review","reason":"救急用品の不足・期限確認時期"},{"id":"EMG-007","layer":"review","reason":"家族の緊急連絡方法の確認時期"},{"id":"EMG-008","layer":"review","reason":"母子手帳・保険情報等の持出し準備確認時期"}]},{"rule_id":"emergency.official_hazard_context","maturity":"experiment_ready","description":"公式の災害・気象情報または事前点検条件がある時だけ表示する","profile_all_tags":["household"],"profile_config_equals":{},"when":{"path":"context.weather.official_disaster_context_or_preseason_review_due","op":"truthy"},"emit":[{"id":"EMG-009","layer":"now","reason":"公式の災害・気象文脈または事前点検条件がある"}]},{"rule_id":"emergency.fire_alarm_review_due","maturity":"experiment_ready","description":"住宅用火災警報器等の点検時期だけ表示する","profile_all_tags":["household"],"profile_config_equals":{},"when":{"path":"household.emergency.fire_alarm_review_due","op":"truthy"},"emit":[{"id":"EMG-010","layer":"review","reason":"住宅用火災警報器等の作動・維持確認時期"}]}]}